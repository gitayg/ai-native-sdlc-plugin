{
  "version": 2,
  "source_of_truth": "linkage",
  "product": {
    "name": "<product-name>",
    "spec_repo": "owner/name",
    "repos": [
      "owner/name"
    ]
  },
  "spec": {
    "path": ".claude/sdlc/spec.md",
    "requirement_id_prefix": "R",
    "ids_are_permanent": true,
    "on_supersede": "mark_with_pointer",
    "on_contradiction": "ask_human",
    "audit_record": "git_diff",
    "home": "product.spec_repo"
  },
  "models": {
    "_note": "Enforced only where a fresh context begins \u2014 a subagent. Stages that run in your session inherit the session model; this block declares intent for those, and the skill says which stage it is in so you can choose.",
    "intake": {
      "effort": "high",
      "model": "inherit",
      "why": "contradiction detection against the whole spec is the hardest call here"
    },
    "build": {
      "effort": "inherit",
      "model": "inherit",
      "why": "your session, your choice"
    },
    "evals": {
      "effort": "low",
      "model": "cheap",
      "why": "mechanical pass/fail, 20-50 of them nightly \u2014 this is where cost lives"
    },
    "review": {
      "effort": "high",
      "model": "inherit",
      "why": "fresh context, adversarial, low volume"
    },
    "diagnose": {
      "effort": "low",
      "model": "cheap",
      "why": "2 sigma is summarising; raise it for 3 sigma"
    }
  },
  "bands": {
    "config": "ops/bands.yaml",
    "detection_command": "python3 ops/ci-failure-rate.py",
    "_note": "The scheduled band check executes detection_command from HERE, never a path read out of bands.yaml. Two sources must agree: this binding and the literal frozen into the scheduled prompt when a human installed it."
  },
  "intent": {
    "channels": [
      "file",
      "text",
      "github_issue",
      "jira_issue"
    ],
    "persist": false
  },
  "artifacts": {
    "path": "docs/sdlc/<slug>",
    "per_change": [
      "plan.md",
      "REVIEW.md"
    ],
    "commit_each_stage": true
  },
  "github": {
    "repo": "owner/name",
    "default_branch": "main",
    "gh_account": "your-gh-login",
    "pr_draft_first": true,
    "issues": {
      "label": "sdlc",
      "branch_pattern": "feature/<issue>-<slug>",
      "pr_title_pattern": "#<issue>: <summary>",
      "stage_labels": {
        "design": "sdlc:design",
        "build": "sdlc:build",
        "test": "sdlc:test",
        "deploy": "sdlc:deploy",
        "done": "sdlc:done"
      }
    }
  },
  "jira": {
    "site": "https://your-org.atlassian.net",
    "project": "PROJ",
    "issue_type": "Story",
    "auth": "env",
    "epic_field": "customfield_10014",
    "branch_pattern": "feature/<issue>-<slug>",
    "pr_title_pattern": "<issue>: <summary>",
    "transitions": {
      "design": "In Design",
      "build": "In Progress",
      "test": "In Review",
      "deploy": "Ready to Release",
      "done": "Done"
    }
  },
  "views": {
    "publish_as_artifact": true,
    "refresh": "on_request"
  }
}
