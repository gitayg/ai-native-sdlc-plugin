{
  "version": 2,
  "source_of_truth": "linkage",
  "product": {
    "name": "<product-name>",
    "spec_repo": "owner/name",
    "repos": [
      "owner/name"
    ]
  },
  "spec": {
    "path": ".claude/sdlc/spec.md",
    "requirement_id_prefix": "R",
    "ids_are_permanent": true,
    "on_supersede": "mark_with_pointer",
    "on_contradiction": "ask_human",
    "audit_record": "git_diff",
    "home": "product.spec_repo"
  },
  "intent": {
    "channels": [
      "file",
      "text",
      "github_issue",
      "jira_issue"
    ],
    "persist": false
  },
  "artifacts": {
    "path": "docs/sdlc/<slug>",
    "per_change": [
      "plan.md",
      "REVIEW.md"
    ],
    "commit_each_stage": true
  },
  "github": {
    "repo": "owner/name",
    "default_branch": "main",
    "gh_account": "your-gh-login",
    "pr_draft_first": true,
    "issues": {
      "label": "sdlc",
      "branch_pattern": "feature/<issue>-<slug>",
      "pr_title_pattern": "#<issue>: <summary>",
      "stage_labels": {
        "design": "sdlc:design",
        "build": "sdlc:build",
        "test": "sdlc:test",
        "deploy": "sdlc:deploy",
        "done": "sdlc:done"
      }
    }
  },
  "jira": {
    "site": "https://your-org.atlassian.net",
    "project": "PROJ",
    "issue_type": "Story",
    "auth": "env",
    "epic_field": "customfield_10014",
    "branch_pattern": "feature/<issue>-<slug>",
    "pr_title_pattern": "<issue>: <summary>",
    "transitions": {
      "design": "In Design",
      "build": "In Progress",
      "test": "In Review",
      "deploy": "Ready to Release",
      "done": "Done"
    }
  },
  "views": {
    "publish_as_artifact": true,
    "refresh": "on_request"
  }
}
